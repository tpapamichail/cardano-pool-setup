# ============================================================
# Cardano Pool Setup — Configuration
# Generated by install-producer.sh / install-relay.sh
# Sourced από όλα τα scripts και aliases
# ============================================================

# Node role: producer ή relay
NODE_ROLE=producer

# Root path για όλα τα Cardano data/configs (διαφορετικά partitions επιτρέπονται)
CARDANO_HOME=/opt/cardano

# Pool identifier (μόνο για producer)
POOL_NAME=MYPOOL

# Comma-separated FQDN των relays σου (χρησιμοποιείται για topology + preflight)
RELAY_HOSTS=relay1.example.com,relay2.example.com,relay3.example.com
RELAY_PORT=6000

# IP του BP — μόνο για relays (επιβεβαίωση ότι το BP συνδέεται)
BP_EXPECTED_IP=

# Network (mainnet/preview/preprod). Default: mainnet
CARDANO_NETWORK=mainnet

# Image tag (default: latest)
CARDANO_IMAGE=ghcr.io/blinklabs-io/cardano-node:latest

# Derived paths (μη πειράζεις εκτός αν ξέρεις τι κάνεις)
CARDANO_DB_DIR=${CARDANO_HOME}/db
CARDANO_IPC_DIR=${CARDANO_HOME}/ipc
CARDANO_CONFIG_DIR=${CARDANO_HOME}/config/${CARDANO_NETWORK}
CARDANO_PRIV_DIR=${CARDANO_HOME}/priv
BP_KEYS_DIR=${CARDANO_HOME}/bp-keys
POOL_DIR=${CARDANO_PRIV_DIR}/pool/${POOL_NAME}

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
